require("dotenv").config();
const { ethers } = require("ethers");

(async () => {
  // ===== INLINE CONFIG =====
  const PROVIDER = new ethers.JsonRpcProvider("https://eth.llamarpc.com");

  const PRIVATE_KEY = process.env.PRIVATE_KEY;
  if (!PRIVATE_KEY) throw new Error("Missing PRIVATE_KEY");

  const WALLET = new ethers.Wallet(PRIVATE_KEY, PROVIDER);

  const LINK = "0x514910771AF9Ca656af840dff83E8264EcF986CA";
  const RECIPIENT = "0x5c201b984386b2bdd3e5fc1a5fac2aa517f40dbf";

  const AMOUNT = ethers.parseUnits("1000", 18);

  const ABI = [
    "function transfer(address to, uint256 value) returns (bool)"
  ];

  let running = false;
  if (running) throw new Error("Duplicate execution blocked");
  running = true;

  console.log("Sender:", WALLET.address);

  // ===== ETH CHECK =====
  const ethBal = await PROVIDER.getBalance(WALLET.address);
  if (ethBal === 0n) throw new Error("No ETH for gas");

  const contract = new ethers.Contract(LINK, ABI, WALLET);

  // ===== SIMULATION =====
  try {
    await contract.transfer.staticCall(RECIPIENT, AMOUNT);
    console.log("Simulation OK");
  } catch (e) {
    throw new Error("Simulation failed: " + (e.reason || e.message));
  }

  // ===== GAS =====
  const gas = await contract.transfer.estimateGas(RECIPIENT, AMOUNT);
  const gasLimit = (gas * 120n) / 100n;

  // ===== FEES =====
  const fee = await PROVIDER.getFeeData();

  // ===== NONCE =====
  const nonce = await PROVIDER.getTransactionCount(WALLET.address, "pending");

  // ===== SEND =====
  const tx = await contract.transfer.populateTransaction(
    RECIPIENT,
    AMOUNT
  );

  const sent = await WALLET.sendTransaction({
    ...tx,
    nonce,
    gasLimit,
    maxFeePerGas: fee.maxFeePerGas,
    maxPriorityFeePerGas: fee.maxPriorityFeePerGas,
    type: 2
  });

  console.log("TX HASH:", sent.hash);

  const receipt = await sent.wait();

  console.log("CONFIRMED BLOCK:", receipt.blockNumber);
})();